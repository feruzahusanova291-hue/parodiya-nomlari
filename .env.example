# GaslightGPT — The Sarcastic Oracle Configuration

# 1. Google Gemini API Kaliti (Tavsiya etiladi - Bepul va juda tezkor):
# Kalitni olish: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OpenAI API Kaliti (agar mavjud bo'lsa):
OPENAI_API_KEY=

# Birlamchi AI modeli (gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash yoki gpt-4o-mini)
DEFAULT_MODEL=gemini-2.5-flash

# Server sozlamalari
PORT=5000
HOST=127.0.0.1
